:8080 {
	encode gzip zstd

	route {
		# Make backend routes win before the SPA fallback.
		@api path /api/*
		reverse_proxy @api 127.0.0.1:8000

		# Local media uploads served by FastAPI.
		@uploads path /uploads/*
		reverse_proxy @uploads 127.0.0.1:8000

		# run-public.sh exports DIARYNEWS_DIST (= <repo>/react-frontend/dist) so the
		# project can move without editing this file; the default covers manual runs.
		root * {$DIARYNEWS_DIST:/Users/yongbinjiang/Documents/Projects/DiaryNews/react-frontend/dist}

		# React SPA fallback
		try_files {path} /index.html
		file_server
	}
}
